# Copy this file to .env and fill in the values you need. .env is gitignored and
# is never committed. Everything here is optional: a build without a .env still
# succeeds, it just ships with push notifications disabled.

# Key the plugin presents to the hosted push relay. Only the Moonfin maintainers
# need this, to stamp official release builds. Anyone running their own relay can
# instead set the Push Relay Key in the plugin settings on a running server, which
# needs no rebuild.
MOONFIN_RELAY_APP_KEY=
