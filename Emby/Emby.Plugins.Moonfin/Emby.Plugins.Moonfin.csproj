<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyVersion>3.1.0.0</AssemblyVersion>
    <FileVersion>3.1.0.0</FileVersion>
    <Version>1.0.0</Version>
    <RootNamespace>Emby.Plugins.Moonfin</RootNamespace>
    <AssemblyName>Emby.Plugins.Moonfin</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Host-provided by Emby: referenced for compile, but not copied/shipped (ExcludeAssets=runtime). -->
    <PackageReference Include="MediaBrowser.Server.Core" Version="4.9.1.90">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="System.Text.Json" Version="8.0.5">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <!-- Emby's IResponse hands out a PipeWriter, and the host ships the assembly. -->
    <PackageReference Include="System.IO.Pipelines" Version="8.0.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <!-- Emby ships SharpCompress 0.33.0 and won't load another version, even one in the plugin folder. -->
    <PackageReference Include="SharpCompress" Version="0.33.0">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Pages\configPage.html" />
    <EmbeddedResource Include="Pages\moonfin.js" />
    <EmbeddedResource Include="../../shared/EmulatorJS/player.html" LogicalName="Emby.Plugins.Moonfin.EmulatorJS.player.html" />
    <EmbeddedResource Include="../../shared/EmulatorJS/moonfin-bridge.js" LogicalName="Emby.Plugins.Moonfin.EmulatorJS.moonfin-bridge.js" />
    <EmbeddedResource Include="Web\loader.js" />
    <EmbeddedResource Include="assets\*.png" />
    <EmbeddedResource Include="assets\*.svg" />
    <EmbeddedResource Include="..\..\shared\PosterBadges\flags\*.svg;..\..\shared\PosterBadges\flags\*.webp">
      <LogicalName>Emby.Plugins.Moonfin.assets.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- The seasonal row's pure logic and rules are shared with the Jellyfin port, so both read
       the same files from the repo's shared folder. -->
  <ItemGroup>
    <Compile Include="../../shared/Calendar/*.cs" Link="Calendar/%(Filename)%(Extension)" />
    <Compile Include="../../shared/LiveTv/*.cs" Link="LiveTv/%(Filename)%(Extension)" />
    <Compile Include="../../shared/MiniGames/*.cs" Link="MiniGames/%(Filename)%(Extension)" />
    <Compile Include="../../shared/Pin/*.cs" Link="Pin/%(Filename)%(Extension)" />
    <Compile Include="../../shared/Seasonal/*.cs" Link="Seasonal/%(Filename)%(Extension)" />
    <Compile Include="../../shared/Seerr/*.cs" Link="Seerr/%(Filename)%(Extension)" />
    <Compile Include="../../shared/Tmdb/*.cs" Link="Tmdb/%(Filename)%(Extension)" />
    <Compile Include="../../shared/Anime/*.cs" Link="Anime/%(Filename)%(Extension)" />
    <Compile Include="../../shared/Romm/*.cs" Link="Romm/%(Filename)%(Extension)" />
    <Compile Include="../../shared/Games/*.cs" Link="Games/%(Filename)%(Extension)" />
    <Compile Include="../../shared/Bookmarks/*.cs" Link="Bookmarks/%(Filename)%(Extension)" />
    <Compile Include="../../shared/Recommendations/*.cs" Link="Recommendations/%(Filename)%(Extension)" />
    <Compile Include="../../shared/SmartSearch/*.cs" Link="SmartSearch/%(Filename)%(Extension)" />
    <Compile Include="../../shared/PosterBadges/*.cs" Link="PosterBadges/%(Filename)%(Extension)" />
    <Compile Include="../../shared/WatchParty/*.cs" Link="WatchParty/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../shared/WatchParty/preview.png" LogicalName="Moonfin.WatchParty.preview.png" />
    <EmbeddedResource Include="../../shared/WatchParty/invite.html" LogicalName="Moonfin.WatchParty.invite.html" />
    <EmbeddedResource Include="../../shared/Seasonal/seasonal-holidays.json" LogicalName="Moonfin.Seasonal.holidays.json" />
  </ItemGroup>

  <!-- Stamps the push relay key into the assembly. The build scripts read it from a
       gitignored .env, so a checkout without one still builds and simply has push off. -->
  <ItemGroup Condition="'$(MoonfinRelayAppKey)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>MoonfinRelayAppKey</_Parameter1>
      <_Parameter2>$(MoonfinRelayAppKey)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="copy $(TargetPath) %AppData%\Emby-Server\programdata\plugins\" />
  </Target>

</Project>
